{
  "scoreThreshold": 80,
  "maxRewrites": 3,
  "onExhaustion": "escalate",
  "failOnTestFailure": true,
  "run": {
    "issue": {
      "github": false
    },
    "checkpoints": ["plan", "commit"],
    "maxCycles": 1
  },
  "plan": {
    "research": {
      "mode": "auto",
      "maxScouts": 4
    },
    "critique": true,
    "maxReplans": 1
  },
  "test": {
    "command": null
  },
  "commit": {
    "style": "conventional",
    "push": false,
    "bumpPluginVersion": "patch"
  },
  "harvest": {
    "scoreThreshold": 80,
    "namePrefix": "WB",
    "skipExisting": true
  }
}
